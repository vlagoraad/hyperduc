@startuml HyperducDiagramaClasses
set separator none
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  ArrowColor #333333
}
skinparam package {
  BorderColor #777777
  FontSize 13
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #BBA800
}

title HYPERDUC! – Diagrama de Classes (Singleton, Template Method, State e Memento)

' ============================ SINGLETON ============================
package "Singleton" #E3F2FD {
  class GerenciadorArquivo <<Singleton>> {
    - {static} instancia : GerenciadorArquivo
    - GerenciadorArquivo()
    + {static} getInstancia() : GerenciadorArquivo
    + ler(caminho : String) : Object
    + gravar(caminho : String, dados : Object) : void
  }
}

' ========================= TEMPLATE METHOD =========================
package "Template Method (persistência)" #E8F5E9 {
  abstract class "RepositorioArquivo<T extends Serializable>" as RepositorioArquivo <<AbstractClass>> {
    - arquivo : GerenciadorArquivo
    # {abstract} getNomeArquivo() : String
    # {abstract} getId(item : T) : Object
    # validar(item : T) : void  <<hook>>
    + listar() : ArrayList<T>  {final}
    + buscarPorId(id : Object) : T  {final}
    + adicionar(item : T) : void  {final}
    + atualizar(item : T) : boolean  {final}
    + remover(id : Object) : boolean  {final}
  }
  class ProjetoRepositorio {
    # getNomeArquivo() : String
    # getId(item : Projeto) : Object
  }
  class AtividadeRepositorio {
    # getNomeArquivo() : String
    # getId(item : Atividade) : Object
  }
  class DenunciaRepositorio {
    # getNomeArquivo() : String
    # getId(item : Denuncia) : Object
    # validar(item : Denuncia) : void
  }
  class ColaboradorRepositorio {
    # getNomeArquivo() : String
    # getId(item : Colaborador) : Object
    # validar(item : Colaborador) : void
  }
}

' ============================ DOMÍNIO ==============================
package "Domínio (Context do State / Originator do Memento)" #FFF3E0 {
  class Projeto {
    - id : int
    - titulo : String
    - descricao : String
    - dataCriacao : LocalDate
    - estado : EstadoProjeto
    + iniciar() : void
    + concluir() : void
    + cancelar() : void
    ~ setEstado(e : EstadoProjeto) : void
    + getStatus() : String
    + salvarEstado() : Projeto.Memento
    + restaurarEstado(m : Projeto.Memento) : void
  }
  class Atividade {
    - id : int
    - titulo : String
    - descricao : String
    - dataCriacao : LocalDate
    - estado : EstadoAtividade
    + atribuir() : void
    + enviarParaRevisao() : void
    + aprovar() : void
    + reprovar() : void
    + cancelar() : void
    ~ setEstado(e : EstadoAtividade) : void
    + getStatus() : String
    + salvarEstado() : Atividade.Memento
    + restaurarEstado(m : Atividade.Memento) : void
  }
  class Denuncia {
    - id : int
    - motivo : String
    - descricao : String
    - alvo : String
    - dataCriacao : LocalDate
    - estado : EstadoDenuncia
    + analisar() : void
    + julgarProcedente() : void
    + arquivar() : void
    ~ setEstado(e : EstadoDenuncia) : void
    + getStatus() : String
    + salvarEstado() : Denuncia.Memento
    + restaurarEstado(m : Denuncia.Memento) : void
  }
  class Colaborador {
    - id : String
    - nome : String
    - email : String
    - funcao : String
  }
}

' ============================== STATE ==============================
package "State – Projeto" #F3E5F5 {
  abstract class EstadoProjeto <<State>> {
    + {abstract} getNome() : String
    + iniciar(p : Projeto) : void
    + concluir(p : Projeto) : void
    + cancelar(p : Projeto) : void
  }
  class "EstadoProjeto.Planejamento" as EP1
  class "EstadoProjeto.EmAndamento" as EP2
  class "EstadoProjeto.Concluido" as EP3
  class "EstadoProjeto.Cancelado" as EP4
}

package "State – Atividade" #F3E5F5 {
  abstract class EstadoAtividade <<State>> {
    + {abstract} getNome() : String
    + atribuir(a : Atividade) : void
    + enviarParaRevisao(a : Atividade) : void
    + aprovar(a : Atividade) : void
    + reprovar(a : Atividade) : void
    + cancelar(a : Atividade) : void
  }
  class "EstadoAtividade.Aberta" as EA1
  class "EstadoAtividade.Atribuida" as EA2
  class "EstadoAtividade.Revisao" as EA3
  class "EstadoAtividade.Concluida" as EA4
  class "EstadoAtividade.Cancelada" as EA5
}

package "State – Denúncia" #F3E5F5 {
  abstract class EstadoDenuncia <<State>> {
    + {abstract} getNome() : String
    + analisar(d : Denuncia) : void
    + julgarProcedente(d : Denuncia) : void
    + arquivar(d : Denuncia) : void
  }
  class "EstadoDenuncia.Aberta" as ED1
  class "EstadoDenuncia.EmAnalise" as ED2
  class "EstadoDenuncia.Procedente" as ED3
  class "EstadoDenuncia.Arquivada" as ED4
}

' ============================= MEMENTO =============================
package "Memento" #FCE4EC {
  class "Projeto.Memento" as PM <<Memento>> {
    - titulo : String
    - descricao : String
    - dataCriacao : LocalDate
    - estado : EstadoProjeto
  }
  class "Atividade.Memento" as AM <<Memento>> {
    - titulo : String
    - descricao : String
    - dataCriacao : LocalDate
    - estado : EstadoAtividade
  }
  class "Denuncia.Memento" as DM <<Memento>> {
    - motivo : String
    - descricao : String
    - alvo : String
    - estado : EstadoDenuncia
  }
  class "Historico<M>" as Historico <<Caretaker>> {
    - pilhas : Map<Object, Deque<M>>
    + salvar(id : Object, m : M) : void
    + desfazer(id : Object) : M
    + podeDesfazer(id : Object) : boolean
  }
}

' ===================== INTERFACE (JavaFX) – Client =================
package "Interface JavaFX (clientes)" #ECEFF1 {
  class Programa {
    + start(stage : Stage) : void
    + criarMenuPrincipal(stage : Stage) : Scene
  }
  class ProjetoAtualizacao {
    - {static} HISTORICO : Historico<Projeto.Memento>
    - repositorio : ProjetoRepositorio
    - atual : Projeto
    - aplicarTransicao(t : Consumer<Projeto>) : void
    - desfazer() : void
  }
  class AtividadeAtualizacao {
    - {static} HISTORICO : Historico<Atividade.Memento>
    - repositorio : AtividadeRepositorio
    - atual : Atividade
    - aplicarTransicao(t : Consumer<Atividade>) : void
    - desfazer() : void
  }
  class DenunciaAtualizacao {
    - {static} HISTORICO : Historico<Denuncia.Memento>
    - repositorio : DenunciaRepositorio
    - atual : Denuncia
    - aplicarTransicao(t : Consumer<Denuncia>) : void
    - desfazer() : void
  }
  class "Telas de CRUD" as Telas <<grupo>> {
    ProjetoInsercao / ProjetoConsulta / ProjetoExclusao
    AtividadeInsercao / AtividadeConsulta / AtividadeExclusao
    DenunciaInsercao / DenunciaConsulta / DenunciaExclusao
    ColaboradorInsercao / ColaboradorConsulta
    ColaboradorAtualizacao / ColaboradorExclusao
  }
  class DemonstracaoPadroes {
    + {static} main(args : String[]) : void
  }
}

' ============================ RELAÇÕES =============================
RepositorioArquivo --> "1" GerenciadorArquivo : usa >
RepositorioArquivo <|-- ProjetoRepositorio
RepositorioArquivo <|-- AtividadeRepositorio
RepositorioArquivo <|-- DenunciaRepositorio
RepositorioArquivo <|-- ColaboradorRepositorio
ProjetoRepositorio ..> Projeto : persiste
AtividadeRepositorio ..> Atividade : persiste
DenunciaRepositorio ..> Denuncia : persiste
ColaboradorRepositorio ..> Colaborador : persiste

Projeto o--> "1" EstadoProjeto : estado
EstadoProjeto <|-- EP1
EstadoProjeto <|-- EP2
EstadoProjeto <|-- EP3
EstadoProjeto <|-- EP4

Atividade o--> "1" EstadoAtividade : estado
EstadoAtividade <|-- EA1
EstadoAtividade <|-- EA2
EstadoAtividade <|-- EA3
EstadoAtividade <|-- EA4
EstadoAtividade <|-- EA5

Denuncia o--> "1" EstadoDenuncia : estado
EstadoDenuncia <|-- ED1
EstadoDenuncia <|-- ED2
EstadoDenuncia <|-- ED3
EstadoDenuncia <|-- ED4

Projeto ..> PM : cria / restaura
Atividade ..> AM : cria / restaura
Denuncia ..> DM : cria / restaura
Historico o--> "0..*" PM
Historico o--> "0..*" AM
Historico o--> "0..*" DM

ProjetoAtualizacao --> Historico
AtividadeAtualizacao --> Historico
DenunciaAtualizacao --> Historico
ProjetoAtualizacao --> ProjetoRepositorio
AtividadeAtualizacao --> AtividadeRepositorio
DenunciaAtualizacao --> DenunciaRepositorio
Telas ..> RepositorioArquivo : usa subclasses
Programa ..> Telas : navega
Programa ..> ProjetoAtualizacao
Programa ..> AtividadeAtualizacao
Programa ..> DenunciaAtualizacao

note right of GerenciadorArquivo
  Única instância responsável
  por ler e gravar os .dat
end note
note bottom of RepositorioArquivo
  Métodos final = template methods:
  ler lista -> localizar por ID -> alterar -> gravar
end note
note bottom of EstadoAtividade
  Aberta -> Atribuída -> Revisão -> Concluída
  Revisão -> Atribuída (reprovar)
  Aberta/Atribuída/Revisão -> Cancelada
end note
note bottom of EstadoProjeto
  Planejamento -> Em andamento -> Concluído
  Planejamento/Em andamento -> Cancelado
end note
note bottom of EstadoDenuncia
  Aberta -> Em análise -> Procedente
  Aberta/Em análise -> Arquivada
end note
@enduml
